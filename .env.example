# Copy to .env and adjust. Used by docker-compose.yml and by the Makefile.

# Host directory holding the PDFs. Mounted read-only at /library in the
# container. For local development the generated sample library lives in
# ./library (see `make sample-library`).
LIBRARY_PATH=./library

# Host directory for the database, the covers and the page cache. Must be a
# local filesystem — SQLite does not belong on NFS or SMB.
DATA_PATH=./data

# Host directory the optional organizer service watches for new PDFs — see
# `docker compose --profile organizer up -d` and docs/organizer.md. Mounted at
# /inbox, and must be a local filesystem too: the organizer locks a file here
# for the length of each run, and that lock is unreliable over NFS or SMB.
INBOX_PATH=./inbox

# User and group the container process drops to, so that files written under
# DATA_PATH belong to you. On a Synology NAS this is usually the share owner, for example 1026:100.
PUID=1000
PGID=1000

# Timezone "today" is decided in, and dates are formatted in on the server.
# Get this right or the front page can be a day out: set your own zone, as an
# IANA name. The default below is UTC, which is almost certainly not it.
TZ=Etc/UTC

# Host port published by docker-compose. The container always listens on 8080.
PORT=8080

# Seconds between automatic scans. 0 switches the schedule off; the Rescan
# button in Settings still works.
PAPERSTAND_SCAN_INTERVAL=900

# Seconds between organizer runs, when the organizer profile is started. Only
# read by that service, never by the main one.
PAPERSTAND_ORGANIZE_INTERVAL=300

# Clients whose X-Forwarded-* headers are believed, as a comma-separated list of
# IP addresses or CIDR blocks. The default trusts loopback only. Behind a
# reverse proxy set it to the proxy's IP, or to * when the proxy is the only
# thing that can reach the port.
PAPERSTAND_TRUSTED_PROXIES=127.0.0.1

# The address the outside world reaches Paperstand at, used to build the
# absolute URLs of the OPDS feed. Leave it empty to take the address from the
# request (corrected by the forwarded headers above); set it when that cannot be
# right — a sub-path, another port, a name that exists only in your DNS.
# PAPERSTAND_BASE_URL=https://paperstand.example.org

# Everything else Paperstand reads is in docs/configuration.md.
